---
import { Icon } from "astro-icon/components";
import { getSeriesList, type SeriesOverview } from "../utils/content-utils";
import { url } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	title?: string;
	description?: string;
	limit?: number;
	seriesList?: SeriesOverview[];
	showAllLink?: boolean;
}

const {
	title = "주제별 시리즈",
	description = "하나의 주제를 여러 글로 이어서 정리합니다.",
	limit,
	seriesList: givenSeriesList,
	showAllLink = true,
} = Astro.props;
const className = Astro.props.class;

const seriesList = (givenSeriesList ?? (await getSeriesList())).slice(0, limit);
---

{seriesList.length > 0 && (
	<section class:list={["card-base px-6 md:px-8 py-6 mb-4 onload-animation", className]}>
		<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-5">
			<div>
				<div class="flex items-center gap-2 text-[var(--primary)] font-bold mb-2">
					<Icon name="material-symbols:library-books-outline-rounded" class="text-2xl" />
					<span>{title}</span>
				</div>
				<p class="text-50 text-sm">{description}</p>
			</div>
			{showAllLink && (
				<a href={url("/series/")} class="link-lg text-sm font-bold text-[var(--primary)] self-start md:self-auto">
					전체 보기
				</a>
			)}
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
			{seriesList.map((series) => (
				<a
					href={series.url}
					class="group no-styling block overflow-hidden rounded-2xl border border-[var(--line-divider)] bg-black/[0.015] dark:bg-white/[0.025] transition hover:border-[var(--primary)]/40 hover:bg-[var(--btn-card-bg-hover)] active:scale-[0.99]"
				>
					{series.cover && (
						<div class="relative h-36 overflow-hidden">
							<ImageWrapper
								src={series.cover}
								alt={`${series.title} cover`}
								position={series.coverPosition}
								class="w-full h-full transition duration-500 group-hover:scale-[1.03]"
							/>
							<div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/35 via-black/5 to-transparent"></div>
						</div>
					)}
					<div class="p-4">
						<div class="flex items-center justify-between gap-3 mb-3">
							<div class="flex flex-wrap items-center gap-2">
								{series.category && (
									<span class="text-xs font-bold rounded-full px-2.5 py-1 bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">
										{series.category}
									</span>
								)}
								{series.totalPosts > 0 && (
									<span class="text-xs font-bold rounded-full px-2.5 py-1 bg-[var(--btn-regular-bg)] text-50">
										총 {series.totalPosts}편
									</span>
								)}
							</div>
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="text-2xl text-[var(--primary)] opacity-70 transition group-hover:translate-x-1"
							/>
						</div>

						<h2 class="text-xl font-bold text-90 mb-2 leading-snug">
							{series.title}
						</h2>
						<p class="text-50 text-sm leading-6 mb-4 line-clamp-2">
							{series.description}
						</p>
					</div>
				</a>
			))}
		</div>
	</section>
)}
